# Supabase — заполните после создания проекта на https://supabase.com
# Пока переменные не заданы, приложение сохраняет данные локально в data/store.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Старый anon key тоже поддерживается как запасной вариант:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
