# Supabase — заполните после создания проекта на https://supabase.com
# Пока переменные не заданы, приложение сохраняет данные локально в data/store.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Старый anon key тоже поддерживается как запасной вариант:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Telegram-бот для быстрого добавления вещей с фото
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=random-secret
# Только ваш chat_id (через запятую, если несколько)
TELEGRAM_ALLOWED_CHAT_IDS=123456789
