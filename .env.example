# Supabase — заполните после создания проекта на https://supabase.com
# Пока переменные пустые, приложение сохраняет данные локально в data/store.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Опционально: сервисный ключ для серверных операций (не публикуйте в клиенте)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
